# IndusPilot Environment Configuration (Tech4Bharat 2026)

# Backend Core Configuration
PROJECT_NAME=IndusPilot
VERSION=1.0.0
API_V1_STR=/api/v1
SECRET_KEY=induspilot-super-secure-production-secret-key-tech4bharat-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (Default: SQLite for immediate local testbed; PostgreSQL for production/docker)
DATABASE_URL=sqlite:///./induspilot.db
# PostgreSQL docker format:
# DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@localhost:5432/induspilot

# Multi-Tenancy Demo Scope
DEFAULT_ORGANIZATION_ID=org_tech4bharat_induspilot_demo
DEFAULT_FACTORY_NAME=Apex Precision Fabrication Works

# File Storage
UPLOAD_DIR=./data/uploads
SAMPLE_DIR=./data/sample_quotations

# LLM Providers (Optional: Falls back to deterministic rule-based algorithms if omitted)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Safeguard Modes
SIMULATION_MODE=true

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

